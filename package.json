{
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "install:dev": "concurrently \"bun run install:backend\" \"bun run install:frontend\"",
    "install:backend": "cd backend && bun install",
    "install:frontend": "cd frontend && bun install",
    "dev:backend": "cd backend && bun --watch src/index.ts",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "bun run build:frontend",
    "build:frontend": "cd frontend && bun run build",
    "hash-password": "cd backend && bun run src/scripts/hash-password.ts",
    "clear-db": "cd backend && bun run src/scripts/clear-db.ts",
    "seed": "cd backend && bun run src/scripts/seed.ts",
    "seed-admin": "cd backend && bun run src/scripts/seed-admin.ts",
    "seed:reset": "bun run clear-db && bun run seed"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.2.1"
  }
}
