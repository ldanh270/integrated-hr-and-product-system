# Urls
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# Dev configs
PORT=5000
NODE_ENV=development

# JWT
# require('crypto').randomBytes(64).toString('hex')
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
FRONTEND_URL=http://localhost:5173

#Resend
RESEND_API_KEY=resnd_api_key
EMAIL_FROM=company@yourdomain.com

# General AI Config
TEST_GEN_API_KEY=<your_test_gen_api_key>
TEST_GEN_BASE_URL=http://localhost:20128/v1
TEST_GEN_MODEL=ag/gemini-3-flash-agent

# Google OAuth 2.0 for recruitment connectors (Google Forms, etc.)
# Create OAuth client in Google Cloud Console (Desktop app or Web application)
# Enable Google Forms API in the same project
# Redirect URI: http://localhost:5000/api/recruitment/oauth/google/callback (dev)
#               https://your-domain.com/api/recruitment/oauth/google/callback (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
