generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum EmployeeStatus {
  active
  inactive
  on_leave
  terminated
}

enum EmployeeType {
  full_time
  part_time // legacy — prefer workScheduleType for schedule logic
  contractor
  intern
}

// Canonical field for PT vs FT hours; decoupled from employment category (EmployeeType).
enum WorkScheduleType {
  full_time
  part_time
}

enum SpentTimeStatus {
  pending
  approved
  rejected
}

enum ProjectMemberWorkMode {
  remote
  onsite
}

enum AttendanceStatus {
  on_time
  late
  early_leave
  absent
  overtime
}

enum ShiftStatus {
  scheduled
  holiday_pending
  confirmed
  cancelled
}

enum HolidayType {
  national
  company
}

enum LeaveType {
  annual_leave
  sick_leave
  maternity_leave
  bereavement_leave
  marriage_leave
  unpaid_leave
  other
}

enum ApplicationType {
  leave
  overtime
  work_from_home
  shift_swap
  business_trip
  late_early
  regime
  resignation
}

enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

enum PartnerApprovalStatus {
  pending
  approved
  rejected
}

enum RegimeType {
  paid
  unpaid
}

enum PayrollStatus {
  draft
  pending_approval
  approved
  rejected
  paid
}

// Gates editability: draft/submitted editable by employee; approved locked; rejected sent back.
enum PartTimeAvailabilityStatus {
  draft
  submitted
  approved
  rejected
}

enum ComponentType {
  addition
  deduction
}

enum ComponentValueType {
  currency
  number
  percentage
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum TaskCreationPolicy {
  leader_only
  all_members
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
  cancelled
  reopened
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum PasswordResetStatus {
  pending
  approved
  rejected
  used
  expired
}

enum ActivityCategory {
  auth
  role
  security
}

enum ActivityAction {
  login
  logout
  failed_login
  role_assigned
  role_revoked
  account_locked
  account_unlocked
}

// ── Recruitment Enums ──
enum RequisitionStatus {
  open
  closed
  rejected
}

enum PostingStatus {
  draft
  open
  paused
  closed
}

enum JobApplicationStatus {
  new
  reviewing
  shortlisted
  interviewing
  final_review
  offer_sent
  offer_accepted
  background_check
  pending_onboarding
  hired
  rejected
  offer_declined
  offer_rescinded
  candidate_withdrew
}

enum CandidateSource {
  website
  linkedin
  referral
  facebook
  twitter
  google_form
  recruitment_agency
  other
}

enum InterviewFormat {
  in_person
  video_call
  phone
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum InterviewResult {
  pass
  fail
  borderline
  pending
}

enum OfferStatus {
  draft
  pending_approval
  sent
  negotiating
  accepted
  declined
  rescinded
}

enum JobLevel {
  intern
  fresher
  junior
  mid
  senior
  lead
  manager
  director
}

// ─── Models ──────────────────────────────────────────────────────────────────

// ── Employee ──
model Employee {
  id               String           @id @default(cuid())
  fullName         String
  username         String
  passwordHash     String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  nationalId       String?
  address          String?
  avatarUrl        String?
  avatarId         String?
  position         String?
  positionId       String?
  positionRel      Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employeeType     EmployeeType     @default(full_time)
  workScheduleType WorkScheduleType @default(full_time) // PT payroll, availability, attendance branching
  status           EmployeeStatus   @default(active)

  // Leave Balances
  totalLeaves Int @default(12)
  usedLeaves  Int @default(0)

  failedLoginCount      Int        @default(0)
  lockedUntil           DateTime?
  startDate             DateTime?  @db.Date
  endDate               DateTime?  @db.Date
  lastLoginAt           DateTime?
  personalEmployeeId    String?
  personalEmployee      Employee?  @relation("PersonalEmployeeLink", fields: [personalEmployeeId], references: [id], onDelete: SetNull)
  personalEmployeeLinks Employee[] @relation("PersonalEmployeeLink")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime? // For soft deletes
  version              Int       @default(1)
  authorizationVersion Int       @default(1)

  // Relations
  attendanceRecords              AttendanceRecord[]
  realShifts                     RealShift[]
  employeeShifts                 EmployeeShift[]              @relation("EmployeeShiftEmployee")
  employeeShiftsCreated          EmployeeShift[]              @relation("EmployeeShiftCreator")
  applications                   Application[]                @relation("ApplicationEmployee")
  applicationsApproved           Application[]                @relation("ApplicationApprover")
  applicationsAssigned           Application[]                @relation("ApplicationAssignedTo")
  applicationBatches             ApplicationBatch[]           @relation("ApplicationBatchEmployee")
  applicationBatchesAssigned     ApplicationBatch[]           @relation("ApplicationBatchAssignedTo")
  swapApplicationsAsPartner      ApplicationShiftSwapDetail[] @relation("ApplicationSwapWith")
  shiftSchedules                 ShiftSchedule[]              @relation("ShiftScheduleEmployee")
  shiftSchedulesCreated          ShiftSchedule[]              @relation("ShiftScheduleCreator")
  workingShiftsCreated           WorkingShift[]
  weeklyScheduleTemplatesCreated WeeklyScheduleTemplate[]     @relation("WeeklyScheduleTemplateCreator")
  holidayCalendarsCreated        HolidayCalendar[]
  salaryVariablesCreated         SalaryVariable[]
  salaryComponentsCreated        SalaryComponent[]
  payslipTemplatesCreated        PayslipTemplate[]
  salaryConfigs                  EmployeeSalaryConfig[]
  salaryConfigsCreated           EmployeeSalaryConfig[]       @relation("SalaryConfigCreator")
  payrollSettingsUpdated         PayrollSettings[]
  weeklyScheduleSettingsUpdated  WeeklyScheduleSettings[]
  payrollsApproved               Payroll[]
  payslips                       Payslip[]
  projectsLead                   Project[]                    @relation("ProjectTeamLeader")
  projectsCreated                Project[]                    @relation("ProjectCreator")
  projectMembers                 ProjectMember[]
  tasksAssigned                  Task[]                       @relation("TaskAssignee")
  tasksCreated                   Task[]                       @relation("TaskCreator")
  activityLogs                   ActivityLog[]
  passwordResetRequests          PasswordResetRequest[]       @relation("PasswordResetRequestEmployee")
  passwordResetRequestsApprd     PasswordResetRequest[]       @relation("PasswordResetRequestApprover")
  refreshTokens                  RefreshToken[]
  spentTimes                     SpentTime[]                  @relation("EmployeeSpentTimes")
  notifications                  Notification[]               @relation("EmployeeNotifications")
  customQueries                  CustomQuery[]
  auditLogsActed                 AuthorizationAuditLog[]      @relation("AuditLogActor")
  auditLogsTargeted              AuthorizationAuditLog[]      @relation("AuditLogTarget")
  employeeRoles                  EmployeeRole[]
  spentTimesApproved             SpentTime[]                  @relation("SpentTimeApprover")

  candidateId String?    @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  jobRequisitionsRequested     JobRequisition[]             @relation("JobRequisitionRequester")
  jobRequisitionsApproved      JobRequisition[]             @relation("JobRequisitionApprover")
  interviewRoundsLead          InterviewRound[]             @relation("InterviewRoundLead")
  interviewRounds              InterviewRoundMember[]
  interviewScorecards          InterviewScorecard[]
  offersCreated                Offer[]                      @relation("OfferCreator")
  offersApproved               Offer[]                      @relation("OfferApprover")
  jobApplicationsRescinded     JobApplication[]             @relation("ApplicationRescinder")
  partTimeWeeklyAvailabilities PartTimeWeeklyAvailability[] @relation("PartTimeAvailabilityEmployee")
  reviewedAvailabilities       PartTimeWeeklyAvailability[] @relation("PartTimeAvailabilityReviewer")

  @@index([status, employeeType])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([lockedUntil])
  @@index([failedLoginCount])
  @@index([email])
  @@index([username])
}

// ── Attendance ──
model WorkingShift {
  id                 String   @id @default(cuid())
  name               String
  startTime          Int // "HH:mm" stored as total minutes from midnight (e.g., 540 for 09:00)
  endTime            Int // "HH:mm" stored as total minutes from midnight (e.g., 1020 for 17:00)
  gracePeriodMinutes Int      @default(15)
  gpsLat             Float?
  gpsLng             Float?
  gpsRadiusMeters    Float    @default(100)
  isActive           Boolean  @default(true)
  createdById        String
  createdBy          Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeShifts EmployeeShift[]

  // Relations for ShiftSchedule weekdays
  shiftScheduleDays           ShiftScheduleDay[]
  weeklyScheduleTemplateDays  WeeklyScheduleTemplateDay[]
  applicationShiftSwapDetails ApplicationShiftSwapDetail[] @relation("ShiftSwapWorkingShift")

  /// @db.Check("start_time >= 0 AND start_time < 1440")
  /// @db.Check("end_time >= 0 AND end_time <= 1440")
  /// @db.Check("grace_period_minutes >= 0 AND grace_period_minutes <= 120")
  /// @db.Check("gps_radius_meters > 0")

  @@index([isActive])
  @@index([createdById])
}

model WeeklyScheduleTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  cycleWeeks  Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   Employee @relation("WeeklyScheduleTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeks          WeeklyScheduleTemplateWeek[]
  shiftSchedules ShiftSchedule[]

  @@index([isActive])
  @@index([createdById])
}

model WeeklyScheduleTemplateWeek {
  id         String                 @id @default(cuid())
  templateId String
  template   WeeklyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekIndex  Int

  days WeeklyScheduleTemplateDay[]

  @@unique([templateId, weekIndex])
}

model WeeklyScheduleTemplateDay {
  id        String                     @id @default(cuid())
  weekId    String
  week      WeeklyScheduleTemplateWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  shiftId   String?
  shift     WorkingShift?              @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([weekId, dayOfWeek])
  @@index([shiftId])
}

model ShiftSchedule {
  id          String                  @id @default(cuid())
  employeeId  String
  employee    Employee                @relation("ShiftScheduleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  validFrom   DateTime
  validTo     DateTime?
  templateId  String?
  template    WeeklyScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cycleWeeks  Int?
  createdById String
  createdBy   Employee                @relation("ShiftScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days           ShiftScheduleDay[]
  employeeShifts EmployeeShift[]

  @@index([employeeId, validFrom(sort: Desc)])
  @@index([validTo])
  @@index([createdById])
  @@index([templateId])
}

model ShiftScheduleDay {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekIndex  Int           @default(0)
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  shiftId    String
  shift      WorkingShift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, weekIndex, dayOfWeek])
  @@index([shiftId])
}

model EmployeeShift {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation("EmployeeShiftEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId      String
  shift        WorkingShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  assignedDate DateTime       @db.Date
  scheduleId   String?
  schedule     ShiftSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  status       ShiftStatus    @default(scheduled)
  isOverride   Boolean        @default(false)
  createdById  String
  createdBy    Employee       @relation("EmployeeShiftCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecord AttendanceRecord?
  overtimeDetails  ApplicationOvertimeDetail[]  @relation("ApplicationOvertimeShift")
  swapDetails      ApplicationShiftSwapDetail[] @relation("ApplicationEmployeeShift")
  swapWithDetails  ApplicationShiftSwapDetail[] @relation("ApplicationSwapWithShift")
  lateEarlyDetails ApplicationLateEarlyDetail[] @relation("ApplicationLateEarlyShift")

  @@unique([employeeId, assignedDate, shiftId])
  @@index([shiftId, assignedDate])
  @@index([status, assignedDate])
  @@index([scheduleId])
  @@index([createdById])
}

model AttendanceRecord {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeShiftId String        @unique
  employeeShift   EmployeeShift @relation(fields: [employeeShiftId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date

  checkInAt  DateTime?
  checkInLat Float?
  checkInLng Float?

  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?

  status            AttendanceStatus
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes   Int              @default(0)
  totalWorkMinutes  Int              @default(0)
  note              String?
  isPaidLeave       Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realShift RealShift?

  @@index([employeeId, date(sort: Desc)])
  // Partial index equivalent in Prisma requires raw SQL setup in migrations, but we create a standard one here
  @@index([status, date(sort: Desc)])
}

/// Snapshot of actual work times derived from check-in/out for the Real Shift calendar view.
model RealShift {
  id                 String           @id @default(cuid())
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceRecordId String           @unique
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  date               DateTime         @db.Date
  actualStartTime    Int // minutes from midnight, derived from checkInAt
  actualEndTime      Int? // minutes from midnight, derived from checkOutAt
  isMatched          Boolean          @default(false) // true when actual bounds equal planned shift times

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date(sort: Desc)])
  @@index([isMatched, date(sort: Desc)])
}

model ApplicationBatch {
  id           String          @id @default(cuid())
  employeeId   String
  employee     Employee        @relation("ApplicationBatchEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  type         ApplicationType
  assignedToId String?
  assignedTo   Employee?       @relation("ApplicationBatchAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  applications Application[]

  @@index([employeeId])
  @@index([assignedToId])
  @@index([type])
}

model Application {
  id            String            @id @default(cuid())
  employeeId    String
  employee      Employee          @relation("ApplicationEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  type          ApplicationType
  status        ApplicationStatus @default(pending)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  note          String?
  attachmentUrl String?
  attachmentId  String?

  approvedById String?
  approvedBy   Employee? @relation("ApplicationApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  rejectReason String?

  assignedToId String?
  assignedTo   Employee? @relation("ApplicationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  batchId String?
  batch   ApplicationBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveDetail        ApplicationLeaveDetail?
  shiftSwapDetail    ApplicationShiftSwapDetail?
  overtimeDetail     ApplicationOvertimeDetail?
  regimeDetail       ApplicationRegimeDetail?
  lateEarlyDetail    ApplicationLateEarlyDetail?
  businessTripDetail ApplicationBusinessTripDetail?
  workFromHomeDetail ApplicationWorkFromHomeDetail?

  @@index([employeeId, status])
  @@index([employeeId, startDate(sort: Desc)])
  @@index([status, type])
  @@index([approvedById])
  @@index([assignedToId])
  @@index([batchId])
}

model ApplicationLeaveDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  regimeType    RegimeType
}

model ApplicationShiftSwapDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Shift original want to swap (employee shift)
  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationEmployeeShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)

  // Shift to swap with (working shift)
  workingShiftId String?
  workingShift   WorkingShift? @relation("ShiftSwapWorkingShift", fields: [workingShiftId], references: [id], onDelete: Cascade)

  // If swap with specific employee and shift instead of any available shift
  swapWithEmployeeId String?
  swapWithEmployee   Employee?      @relation("ApplicationSwapWith", fields: [swapWithEmployeeId], references: [id], onDelete: Cascade)
  swapWithShiftId    String?
  swapWithShift      EmployeeShift? @relation("ApplicationSwapWithShift", fields: [swapWithShiftId], references: [id], onDelete: Cascade)

  partnerApprovalStatus PartnerApprovalStatus? @default(pending)

  @@index([employeeShiftId])
  @@index([workingShiftId])
  @@index([swapWithEmployeeId])
  @@index([swapWithShiftId])
}

model ApplicationOvertimeDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationOvertimeShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)

  overtimeHours Float @default(0)

  @@index([employeeShiftId])
}

model ApplicationRegimeDetail {
  applicationId        String      @id
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  regimeType           RegimeType
  reducedMinutesPerDay Int         @default(0)
  applyToStart         Boolean     @default(false)
  applyToEnd           Boolean     @default(false)
  documentUrl          String?
}

model ApplicationLateEarlyDetail {
  applicationId   String        @id
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationLateEarlyShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)
  durationMinutes Int
  isLate          Boolean

  @@index([employeeShiftId])
}

model ApplicationBusinessTripDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  location      String
  purpose       String?
  budget        Decimal?    @db.Decimal(15, 2)
}

model ApplicationWorkFromHomeDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  location      String?
}

model HolidayCalendar {
  id          String      @id @default(cuid())
  date        DateTime    @unique @db.Date
  name        String
  type        HolidayType
  createdById String
  createdBy   Employee    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, date])
  @@index([createdById])
}

// ── Payroll ──
model SalaryComponent {
  id          String             @id @default(cuid())
  code        String             @unique @default(cuid())
  name        String             @unique
  type        ComponentType
  valueType   ComponentValueType @default(currency)
  formula     String
  description String?
  isActive    Boolean            @default(true)
  createdById String
  createdBy   Employee           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslipTemplateComponents PayslipTemplateComponent[]
  payslipDetails            PayslipDetail[]

  @@index([type, isActive])
  @@index([createdById])
}

model PayslipTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components    PayslipTemplateComponent[]
  salaryConfigs EmployeeSalaryConfig[]

  @@index([isActive])
  @@index([createdById])
}

model PayslipTemplateComponent {
  templateId      String
  template        PayslipTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  componentId     String
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  overrideFormula String?

  @@id([templateId, componentId])
  @@index([componentId])
}

model EmployeeSalaryConfig {
  id         String          @id @default(cuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  templateId String
  template   PayslipTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // ── Lương chính ─────────────────────────────────
  baseSalary Decimal @db.Decimal(15, 2)
  // Lương cứng hàng tháng — NOT NULL

  // ── Versioning ──────────────────────────────────
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?

  createdById String
  createdBy   Employee @relation("SalaryConfigCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([templateId])
  @@index([effectiveTo])
  @@index([createdById])
}

model SalaryVariable {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  value       Decimal @default(0) @db.Decimal(15, 2)
  description String?
  isActive    Boolean @default(true)

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model PayrollSettings {
  id            String   @id @default("GLOBAL")
  triggerDay    Int
  triggerHour   Int      @default(0)
  triggerMinute Int      @default(0)
  updatedById   String
  updatedBy     Employee @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

model WeeklyScheduleSettings {
  id                   String   @id @default("GLOBAL")
  triggerDayOfWeek     Int
  triggerHour          Int      @default(7)
  triggerMinute        Int      @default(0)
  lastGeneratedWeekKey String?
  updatedById          String
  updatedBy            Employee @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

// Employee-declared free/busy windows per ISO week; admin assigns shifts once status is submitted.
model PartTimeWeeklyAvailability {
  id           String                     @id @default(cuid())
  employeeId   String
  employee     Employee                   @relation("PartTimeAvailabilityEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart    DateTime                   @db.Date
  status       PartTimeAvailabilityStatus @default(submitted)
  note         String?
  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   Employee?                  @relation("PartTimeAvailabilityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days PartTimeAvailabilityDay[]

  @@unique([employeeId, weekStart])
  @@index([weekStart])
  @@index([status])
  @@index([reviewedById])
}

// One row per weekday (0=Sun … 6=Sat); isBusyAllDay blocks all shift assignment that day.
model PartTimeAvailabilityDay {
  id             String                     @id @default(cuid())
  availabilityId String
  availability   PartTimeWeeklyAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  isBusyAllDay   Boolean                    @default(false)

  slots PartTimeAvailabilitySlot[]

  @@unique([availabilityId, dayOfWeek])
}

// Free windows as minutes-from-midnight; assigned shifts must fall within these bounds.
model PartTimeAvailabilitySlot {
  id        String                  @id @default(cuid())
  dayId     String
  day       PartTimeAvailabilityDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startTime Int
  endTime   Int
  sortOrder Int                     @default(0)

  @@index([dayId])
}

model Payroll {
  id           String        @id @default(cuid())
  name         String        @default("Bảng lương")
  periodMonth  Int
  periodYear   Int
  status       PayrollStatus @default(draft)
  /// Derived: SUM(payslips.netSalary). Must be updated in same transaction as payslip changes.
  totalAmount  Decimal       @default(0) @db.Decimal(15, 2)
  approvedById String?
  approvedBy   Employee?     @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([periodYear, periodMonth, name])
  @@index([status])
  @@index([approvedById])
}

model Payslip {
  id         String   @id @default(cuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  salaryConfigId String
  salaryConfig   EmployeeSalaryConfig @relation(fields: [salaryConfigId], references: [id], onDelete: Restrict)

  totalAdditions  Decimal @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal @default(0) @db.Decimal(15, 2)
  netSalary       Decimal @db.Decimal(15, 2)
  workingDays     Int     @default(0)
  absentDays      Int     @default(0)
  overtimeMinutes Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details PayslipDetail[]

  @@unique([payrollId, employeeId])
  @@index([employeeId, payrollId(sort: Desc)])
  @@index([salaryConfigId])
}

model PayslipDetail {
  id          String          @id @default(cuid())
  payslipId   String
  payslip     Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  /// Snapshot: name of component at time of payroll calculation (component name may change later)
  name        String
  /// Snapshot: type of component at time of payroll calculation
  type        ComponentType
  value       Decimal         @db.Decimal(15, 2)

  @@index([payslipId])
  @@index([componentId])
}

// ── Project & Product ──
model Project {
  id                 String             @id @default(cuid())
  name               String             @unique
  description        String?
  techStack          String[] // Array of strings in PG
  status             ProjectStatus      @default(planning)
  taskCreationPolicy TaskCreationPolicy @default(leader_only)
  startDate          DateTime?
  expectedEndDate    DateTime?
  actualEndDate      DateTime?
  teamLeaderId       String?
  teamLeader         Employee?          @relation("ProjectTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          Employee           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             ProjectMember[]
  tasks               Task[]
  customQueries       CustomQuery[]
  taskStatuses        ProjectTaskStatus[]
  roles               ProjectRole[]
  allowedTaskTrackers String[]
  trackers            ProjectTracker[]

  @@index([status])
  @@index([teamLeaderId, status])
  @@index([createdById])
}

/// PT per-project contract: rate for payroll, workMode for attendance (remote vs onsite GPS).
model ProjectMember {
  projectId  String
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Hourly rate for approved Spent Time on this project (PT employees).
  hourlyRate Decimal?              @db.Decimal(12, 2)
  /// remote = Spent Time only; onsite = one GPS check-in per day, then Spent Time.
  workMode   ProjectMemberWorkMode @default(remote)
  roleId     String?
  role       ProjectRole?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  joinedAt   DateTime              @default(now())
  removedAt  DateTime?

  @@id([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  tracker       String       @default("feature")
  priority      TaskPriority @default(medium)
  status        TaskStatus   @default(todo)
  assigneeId    String?
  assignee      Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     Employee     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  startDate     DateTime?    @db.Date
  dueDate       DateTime?
  completedAt   DateTime?
  estimatedTime Float?
  progress      Int          @default(0)

  resultUrl       String?
  resultNotes     String?
  rejectionReason String?
  parentTaskId    String?
  parentTask      Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks        Task[]  @relation("TaskSubtasks")

  statusId     String?
  customStatus ProjectTaskStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spentTimes SpentTime[] @relation("TaskSpentTimes")

  @@index([projectId, status])
  @@index([projectId, statusId])
  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@index([createdById])
  @@index([parentTaskId])
}

// ── Auth ──
model ActivityLog {
  id         String           @id @default(cuid())
  employeeId String?
  employee   Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category   ActivityCategory @default(auth)
  actionType ActivityAction
  ipAddress  String?
  details    Json?            @db.JsonB // JsonB type for flexible metadata
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([category, actionType, createdAt])
  @@index([category])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id           String              @id @default(cuid())
  employeeId   String
  employee     Employee            @relation("PasswordResetRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  token        String              @unique
  status       PasswordResetStatus @default(pending)
  approvedById String?
  approvedBy   Employee?           @relation("PasswordResetRequestApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  note         String?
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([expiresAt])
  @@index([approvedById])
}

model RefreshToken {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // SHA-256 hash của raw token
  expiresAt  DateTime // Fixed — kế thừa từ lần login gốc, không rolling
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? // null = còn hợp lệ

  @@index([employeeId])
  @@index([expiresAt])
}

/// PT time log on a task — pending until lead approves; approved rows feed payroll.
model SpentTime {
  id              String          @id @default(cuid())
  taskId          String
  task            Task            @relation("TaskSpentTimes", fields: [taskId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation("EmployeeSpentTimes", fields: [employeeId], references: [id], onDelete: Restrict)
  date            DateTime        @db.Date
  hours           Float
  comment         String?
  activity        String
  /// working_day vs overtime — OT uses multiplier in payroll calculation.
  workTimeType    String          @default("working_day")
  status          SpentTimeStatus @default(pending)
  approvedById    String?
  approvedBy      Employee?       @relation("SpentTimeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([taskId])
  @@index([employeeId])
  @@index([status, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      Employee @relation("EmployeeNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("system")
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
}

// ── Dynamic RBAC ──

model AppRole {
  id               String  @id @default(cuid())
  name             String  @unique
  description      String?
  isSystem         Boolean @default(false)
  isActive         Boolean @default(true)
  isAdministrative Boolean @default(false)
  isDefault        Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  permissions RolePermission[]
  employees   EmployeeRole[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isDefault])
  @@index([isAdministrative, isActive, deletedAt])
  @@map("roles")
}

model AdminStateLock {
  id Int @id @default(1)

  @@map("admin_state_lock")
}

model Permission {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // Convention: module.action
  module      String
  description String?
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  roles RolePermission[]

  @@index([module])
  @@index([deletedAt])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  employeeId String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     AppRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

model AuthorizationAuditLog {
  id                 String  @id @default(uuid())
  actorId            String?
  targetEmployeeId   String?
  targetRoleId       String?
  targetPermissionId String?

  action   String
  oldValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  actor          Employee? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetEmployee Employee? @relation("AuditLogTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetEmployeeId])
  @@index([targetRoleId])
  @@index([createdAt])
  @@index([action])
  @@map("authorization_audit_logs")
}

// ── CustomQuery ──
model CustomQuery {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("gantt")
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  queryData  String // JSON string storing filters
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, type])
}

model ProjectTaskStatus {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // Tên trạng thái, ví dụ: "Idea", "To Do", "In Progress", "Done"
  color       String   @default("#A3A3A3") // Mã màu sắc đại diện
  order       Int      @default(0) // Thứ tự hiển thị cột trên Kanban Board
  isDefault   Boolean  @default(false) // Nhãn mặc định khi tạo mới Task
  isCompleted Boolean  @default(false) // Đánh dấu trạng thái đã hoàn thành (như Done, Closed)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId])
}

model JobDescription {
  id            String         @id @default(cuid())
  requisitionId String         @unique
  requisition   JobRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  description   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
}

model ExternalJobPost {
  id            String          @id @default(cuid())
  requisitionId String
  requisition   JobRequisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  source        CandidateSource
  postUrl       String?
  isActive      Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
}

model Candidate {
  id          String  @id @default(cuid())
  fullName    String
  email       String  @unique
  phone       String? @unique
  resumeUrl   String?
  linkedinUrl String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobApplications JobApplication[]
  employee        Employee?
}

model JobApplication {
  id            String               @id @default(cuid())
  candidateId   String
  candidate     Candidate            @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  requisitionId String
  requisition   JobRequisition       @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  source        CandidateSource      @default(other)
  status        JobApplicationStatus @default(new)
  kanbanOrder   Int                  @default(0)

  rejectedAt      DateTime?
  rejectedReason  String?
  withdrawnAt     DateTime?
  rescindedAt     DateTime?
  rescindedReason String?
  rescindedById   String?
  rescindedBy     Employee? @relation("ApplicationRescinder", fields: [rescindedById], references: [id], onDelete: SetNull)
  hiredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewRoundCandidates InterviewRoundCandidate[]
  offers                   Offer[]
  scores                   InterviewScorecard[]

  @@index([status, kanbanOrder])
  @@index([candidateId])
  @@index([requisitionId])
}

model InterviewRound {
  id            String          @id @default(cuid())
  requisitionId String
  requisition   JobRequisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  roundNumber   Int
  title         String
  format        InterviewFormat @default(in_person)
  status        InterviewStatus @default(scheduled)

  scheduledAt DateTime?
  completedAt DateTime?

  leadInterviewerId String
  leadInterviewer   Employee @relation("InterviewRoundLead", fields: [leadInterviewerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewers InterviewRoundMember[]
  candidates   InterviewRoundCandidate[]
  scorecards   InterviewScorecard[]

  @@unique([requisitionId, roundNumber])
  @@index([requisitionId, status])
}

model InterviewRoundCandidate {
  roundId       String
  round         InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([roundId, applicationId])
  @@index([applicationId])
}

model InterviewRoundMember {
  roundId    String
  round      InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([roundId, employeeId])
  @@index([employeeId])
}

model InterviewScorecard {
  id            String         @id @default(cuid())
  roundId       String
  round         InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   Employee       @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  scores  Json            @db.JsonB
  verdict InterviewResult @default(pending)
  note    String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([roundId, applicationId, interviewerId])
  @@index([roundId])
  @@index([applicationId])
}

model Offer {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version       Int            @default(1)
  position      String
  salary        Decimal        @db.Decimal(15, 2)
  startDate     DateTime       @db.Date
  benefits      String?
  status        OfferStatus    @default(draft)

  sentAt           DateTime?
  respondedAt      DateTime?
  responseDeadline DateTime?
  declineReason    String?

  createdById  String
  createdBy    Employee  @relation("OfferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   Employee? @relation("OfferApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history OfferHistory[]

  @@unique([applicationId, version])
  @@index([applicationId, status])
}

model OfferHistory {
  id      String  @id @default(cuid())
  offerId String
  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  actor   String // "HR" or "CANDIDATE"
  salary  Decimal @db.Decimal(15, 2)
  note    String?

  createdAt DateTime @default(now())

  @@index([offerId])
}

// ── Recruitment Models ──

model JobRequisition {
  id              String            @id @default(cuid())
  title           String
  departmentName  String
  headcountNeeded Int
  budgetMin       Decimal?          @db.Decimal(15, 2)
  budgetMax       Decimal?          @db.Decimal(15, 2)
  status          RequisitionStatus @default(open)
  level           JobLevel          @default(junior)
  targetStartDate DateTime?         @db.Date
  note            String?

  requestedById String
  requestedBy   Employee  @relation("JobRequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    Employee? @relation("JobRequisitionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobDescription   JobDescription?
  externalJobPosts ExternalJobPost[]
  jobApplications  JobApplication[]
  interviewRounds  InterviewRound[]

  @@index([status])
  @@index([requestedById])
  @@index([approvedById])
}

model Position {
  id                      String            @id @default(cuid())
  name                    String            @unique
  code                    String            @unique // ví dụ: "developer", "tester", "pm"
  description             String?
  allowedTaskTrackers     String[]
  allowedApplicationTypes ApplicationType[]

  employees Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("positions")
}

model ProjectRole {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  code                String
  allowedTaskTrackers String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members ProjectMember[]

  @@unique([projectId, name])
  @@unique([projectId, code])
  @@map("project_roles")
}

model ProjectTracker {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, code])
  @@map("project_trackers")
}
