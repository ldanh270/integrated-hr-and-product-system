PORT=3001
HRP_API_BASE_URL=http://localhost:5000

# REQUIRED — Public URL the AI agent will hand to users for the browser-based login.
# Must include scheme (http:// or https://). No trailing slash. No port unless non-default.
# Used for BOTH dev and prod — there is no localhost fallback.
# Examples:
#   Local dev : http://localhost:3001
#   ngrok     : https://your-subdomain.ngrok-free.dev
#   Prod/nginx: https://hrp-mcp.example.com
PUBLIC_BASE_URL=http://localhost:3001

# Set to true to enable verbose HTTP body and debug logs
DEBUG=false
