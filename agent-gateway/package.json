      "onFail": "download"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.44",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antfu/ni": "^30.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.30",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
