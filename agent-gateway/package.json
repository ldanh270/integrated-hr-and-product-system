{
  "name": "@ldanh270/hrp-agent-gateway",
  "version": "1.0.0",
  "description": "Telegram AI Agent Gateway tích hợp HRP MCP Server",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devEngines": {
