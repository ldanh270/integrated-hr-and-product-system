# ================================
# Telegram Bot
# ================================
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ================================
# 9Router / LLM Provider
# ================================
NINE_ROUTER_BASE_URL=https://openrouter.ai/api/v1
NINE_ROUTER_API_KEY=sk-or-...
# Routing: "openai/gpt-4o-mini" | "anthropic/claude-3-5-haiku" | etc.
NINE_ROUTER_MODEL=openai/gpt-4o-mini

# ================================
# MCP Server (internal Docker network)
# ================================
MCP_SSE_URL=http://mcp:3001/mcp/sse
MCP_MESSAGE_URL=http://mcp:3001/mcp/message

# ================================
# Redis
# ================================
REDIS_URL=redis://redis:6379

# ================================
# App
# ================================
NODE_ENV=development
# Optional: Port for Express health-check endpoint
PORT=3002

# Maximum time for an LLM response and MCP tool-call loop
AGENT_TIMEOUT_MS=60000
