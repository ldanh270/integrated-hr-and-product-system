            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Frontend Engineer\",\n  \"departmentName\": \"Engineering\",\n  \"headcountNeeded\": 2,\n  \"budgetMin\": 2000,\n  \"budgetMax\": 4000,\n  \"jobFamily\": \"engineering\",\n  \"level\": \"senior\"\n}",
