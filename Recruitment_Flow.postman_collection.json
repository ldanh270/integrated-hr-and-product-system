{
  "info": {
    "name": "HRM Recruitment Flow",
    "description": "API collection for testing the HRM Recruitment Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Job Requisition",
      "item": [
        {
          "name": "Create Requisition",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/job-requisitions", "host": ["{{baseUrl}}"], "path": ["job-requisitions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Frontend Engineer\",\n  \"departmentName\": \"Engineering\",\n  \"headcountNeeded\": 2,\n  \"budgetMin\": 2000,\n  \"budgetMax\": 4000,\n  \"jobFamily\": \"engineering\",\n  \"level\": \"senior\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Approve Requisition (GM only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/job-requisitions/REPLACE_REQ_ID/status", "host": ["{{baseUrl}}"], "path": ["job-requisitions", "REPLACE_REQ_ID", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "2. Job Posting",
      "item": [
        {
          "name": "Create Posting",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/job-postings", "host": ["{{baseUrl}}"], "path": ["job-postings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requisitionId\": \"REPLACE_REQ_ID\",\n  \"platform\": \"linkedin\",\n  \"externalUrl\": \"https://linkedin.com/jobs/123\",\n  \"closingDate\": \"2027-12-31T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "3. Application",
      "item": [
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/job-applications/apply", "host": ["{{baseUrl}}"], "path": ["job-applications", "apply"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requisitionId\": \"REPLACE_REQ_ID\",\n  \"postingId\": \"REPLACE_POSTING_ID\",\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"0987654321\",\n  \"resumeUrl\": \"https://example.com/cv.pdf\",\n  \"source\": \"linkedin\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "4. Interview",
      "item": [
        {
          "name": "Schedule Interview Round",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/interviews/round", "host": ["{{baseUrl}}"], "path": ["interviews", "round"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"REPLACE_APP_ID\",\n  \"type\": \"technical\",\n  \"roundName\": \"Technical React Interview\",\n  \"startTime\": \"2026-07-01T10:00:00Z\",\n  \"endTime\": \"2026-07-01T11:00:00Z\",\n  \"location\": \"Google Meet\",\n  \"interviewerIds\": [\"REPLACE_EMPLOYEE_ID_1\", \"REPLACE_EMPLOYEE_ID_2\"]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Submit Scorecard",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/interviews/scorecard", "host": ["{{baseUrl}}"], "path": ["interviews", "scorecard"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roundId\": \"REPLACE_ROUND_ID\",\n  \"verdict\": \"pass\",\n  \"technicalScore\": 4,\n  \"cultureScore\": 5,\n  \"comments\": \"Very good candidate\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "5. Offer",
      "item": [
        {
          "name": "Create Offer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/offers", "host": ["{{baseUrl}}"], "path": ["offers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"REPLACE_APP_ID\",\n  \"position\": \"Senior Frontend Engineer\",\n  \"department\": \"Engineering\",\n  \"baseSalary\": 3000,\n  \"currency\": \"USD\",\n  \"startDate\": \"2026-08-01T00:00:00Z\",\n  \"probationMonths\": 2,\n  \"benefits\": \"Health insurance, Gym\",\n  \"deadline\": \"2026-07-10T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Candidate Respond to Offer",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/offers/REPLACE_OFFER_ID/respond", "host": ["{{baseUrl}}"], "path": ["offers", "REPLACE_OFFER_ID", "respond"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accepted\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "6. Background Check",
      "item": [
        {
          "name": "Initiate Background Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/background-checks", "host": ["{{baseUrl}}"], "path": ["background-checks"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"REPLACE_APP_ID\",\n  \"provider\": \"Checkr\",\n  \"notes\": \"Standard criminal + education check\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update Background Check Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/background-checks/REPLACE_BGC_ID/status", "host": ["{{baseUrl}}"], "path": ["background-checks", "REPLACE_BGC_ID", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"passed\",\n  \"notes\": \"All clear\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "7. Onboarding",
      "item": [
        {
          "name": "Convert Candidate to Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/onboarding/REPLACE_APP_ID/convert", "host": ["{{baseUrl}}"], "path": ["onboarding", "REPLACE_APP_ID", "convert"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-08-01T00:00:00Z\",\n  \"position\": \"Senior Frontend Engineer\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
  ]
}
