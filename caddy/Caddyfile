{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle /mcp/* {
		reverse_proxy mcp:3001 {
			flush_interval -1
		}
	}

	handle /gateway/health {
		rewrite * /health
		reverse_proxy agent-gateway:3002
	}

	handle /health {
		respond "OK" 200
	}

	handle {
		respond "HRP services are running" 200
	}
}
